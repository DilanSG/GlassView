# GlassView2.0 — Backend

# Conexión a MongoDB Atlas (o MongoDB local)
# Ejemplo Atlas: mongodb+srv://usuario:contrasena@cluster.mongodb.net/glassview
MONGO_URI=mongodb://localhost:27017/glassview

# Puerto del servidor
PORT=4000

# PIN compartido para acceder a la aplicación (cámbialo)
ACCESS_CODE=cambia-este-pin

# Secreto para firmar el token de acceso (cambia esta clave)
SECRET_TOKEN=cambia-este-secreto

# Orígenes permitidos por CORS, separados por comas
ALLOWED_ORIGINS=http://localhost:5173