# GlassView — Backend

# Conexión a MongoDB Atlas (o MongoDB local)
# Ejemplo Atlas: mongodb+srv://usuario:contrasena@cluster.mongodb.net/glassview
MONGO_URI=mongodb://localhost:27017/glassview

# Puerto del servidor
PORT=4000

# Secreto para firmar el token de sesión (cambia esta clave)
SECRET_TOKEN=cambia-este-secreto

# Días de prueba gratuita para cada cuenta nueva
TRIAL_DAYS=10

# Precio mensual de la suscripción en dólares
PRICE_USD=10

# Cuenta administradora que se crea al arrancar (opcional)
ADMIN_EMAIL=admin@glassview.app
ADMIN_PASSWORD=cambia-esta-contrasena

# Orígenes permitidos por CORS, separados por comas
ALLOWED_ORIGINS=http://localhost:5173
